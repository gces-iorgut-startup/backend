# ==============================================================================
# Template de Variáveis de Produção — VPS (~/app/iougurt)
# NUNCA commite arquivos reais preenchidos no repositório.
# Na VPS, separe em dois arquivos protegidos com `chmod 600 .env.db .env.api`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1) Arquivo ~/app/iougurt/.env.db (consumido apenas pelo container PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=iougurt_prod
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_ALEATORIA
POSTGRES_DB=iougurt_prod

# ------------------------------------------------------------------------------
# 2) Arquivo ~/app/iougurt/.env.api (consumido apenas pelo container Backend)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# URL do banco apontando para o serviço interno "db" na rede Docker iougurt-shared
DATABASE_URL=postgresql://iougurt_prod:TROQUE_POR_SENHA_FORTE_ALEATORIA@db:5432/iougurt_prod?schema=public

# URLs públicas reais (HTTPS)
APP_URL=https://seu-dominio.com/api
FRONTEND_URL=https://seu-dominio.com
CORS_ORIGIN=https://seu-dominio.com

# Segredos criptográficos (gere com: openssl rand -hex 32)
JWT_SECRET=TROQUE_POR_SEGREDO_DE_NO_MINIMO_32_CHARS
PASSWORD_RESET_SECRET=TROQUE_POR_OUTRO_SEGREDO_FORTE_32_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Hardening: mantenha false em produção para não expor o Swagger UI público
ENABLE_SWAGGER=false

# Integrações externas
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
RESEND_API_KEY=
MAIL_FROM=

# IMPORTANTE: NÃO defina E2E_TEST_SECRET em produção.
# Em NODE_ENV=production a API recusa iniciar caso E2E_TEST_SECRET esteja preenchido.

# ------------------------------------------------------------------------------
# 3) Arquivo ~/app/iougurt/.env (lido pelo Docker Compose para resolver imagens)
# ------------------------------------------------------------------------------
DOCKERHUB_USERNAME=seu-usuario-dockerhub
API_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
FRONTEND_PORT=8080
